*.pyc
__pycache__/
.mypy_cache/
.pytest_cache/

# Node.js specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java specific
*.class
*.jar
*.war
*.ear
.gradle/
build/

# C/C++ specific
*.o
*.a
*.so
*.dll
*.exe
*.out

# Compressed files
*.zip
*.gz
