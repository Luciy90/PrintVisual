# HTTP port for the local web interface (default: 8765)
PORT=8765

# Bind address. Keep localhost unless external access is explicitly secured.
HOST=localhost

# Static frontend directory relative to the project root (default: public)
PUBLIC_DIR=public

# Runtime settings directory relative to the project root (default: data)
DATA_DIR=data

# Use development for local diagnostics or production for cacheable static assets.
NODE_ENV=development
