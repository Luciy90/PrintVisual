{
  "name": "printvisual",
  "version": "2.0.1",
  "private": true,
  "description": "PrintVisual Node.js/Express/TypeScript application for 3D printer camera monitoring.",
  "type": "module",
  "main": "dist/desktop.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "node scripts/build-client.mjs",
    "build:server": "tsc -p tsconfig.json",
    "desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --win dir --x64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck:server && npm run typecheck:client",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "ru.printvisual.desktop",
    "productName": "PrintVisual",
    "artifactName": "PrintVisual-Setup-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*.js",
      "public/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "PrintVisual",
      "uninstallDisplayName": "PrintVisual"
    }
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^3.2.4",
    "electron": "^41.10.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@41.10.1": true,
    "esbuild@0.28.1": true
  }
}
